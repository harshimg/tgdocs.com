---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TGDocs - Privacy-First Telegram Cloud File Manager",
  description = "A Google Drive-inspired client layer for managing your personal files stored securely in Telegram Cloud. 100% client-side, zero middleman servers, free & open source.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b57d0" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://tgdocs.com" />

    <!-- Privacy & Security CSP: Restrict outbound network calls to Telegram MTProto WebSockets and self -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' wss://*.web.telegram.org wss://*.telegram.org https://*.telegram.org blob:; img-src 'self' data: blob: https:; media-src 'self' blob:; worker-src 'self' blob:;"
    />
  </head>
  <body class="bg-[#f0f4f9] dark:bg-[#131314] text-[#1f1f1f] dark:text-[#e3e3e3] antialiased overflow-hidden min-h-[100dvh] h-[100dvh]">
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
  }
</style>
