---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="security" class="relative py-20 bg-[#f8fafc] dark:bg-[#151719] border-b border-[#e5e7eb] dark:border-[#26292c]">
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#f0f4f8] dark:bg-[#212427] text-[#0082c8] text-xs font-semibold uppercase tracking-wider mb-3 border border-[#e2e8f0] dark:border-[#2e3236]">
        <span>{t('security.tag')}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#191b1d] dark:text-[#fafafa] tracking-tight mb-3">
        {t('security.title')}
      </h2>
      <p class="text-base text-[#5d6c7b] dark:text-[#8e9295] leading-relaxed">
        {t('security.subtitle')}
      </p>
    </div>

    <!-- Comparison Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 max-w-4xl mx-auto mb-12">
      
      <!-- Traditional Cloud Providers Card -->
      <div class="p-6 sm:p-7 rounded-2xl bg-white dark:bg-[#212427] border border-[#e2e8f0] dark:border-[#282b2e] shadow-sm">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-8 h-8 rounded-lg bg-[#fee2e2] dark:bg-[#3d2424] text-[#dc2626] flex items-center justify-center font-bold text-sm">
            &times;
          </div>
          <h3 class="text-base sm:text-lg font-bold text-[#191b1d] dark:text-[#fafafa]">{t('security.tradTitle')}</h3>
        </div>

        <ul class="space-y-3.5 text-xs sm:text-sm text-[#5d6c7b] dark:text-[#8e9295]">
          <li class="flex items-start gap-2.5">
            <span class="text-[#dc2626] font-bold shrink-0 mt-0.5">&times;</span>
            <span>{t('security.tradP1')}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#dc2626] font-bold shrink-0 mt-0.5">&times;</span>
            <span>{t('security.tradP2')}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#dc2626] font-bold shrink-0 mt-0.5">&times;</span>
            <span>{t('security.tradP3')}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#dc2626] font-bold shrink-0 mt-0.5">&times;</span>
            <span>{t('security.tradP4')}</span>
          </li>
        </ul>
      </div>

      <!-- TGDocs Architecture Card -->
      <div class="p-6 sm:p-7 rounded-2xl bg-white dark:bg-[#1f252d] border border-[#0082c8]/40 dark:border-[#0082c8]/60 shadow-sm">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-8 h-8 rounded-lg bg-[#0082c8] text-white flex items-center justify-center font-bold text-sm shadow-sm">
            &#10003;
          </div>
          <h3 class="text-base sm:text-lg font-bold text-[#191b1d] dark:text-[#fafafa]">{t('security.tgTitle')}</h3>
        </div>

        <ul class="space-y-3.5 text-xs sm:text-sm text-[#374151] dark:text-[#d1d5db]">
          <li class="flex items-start gap-2.5">
            <span class="text-[#27a644] font-bold shrink-0 mt-0.5">&#10003;</span>
            <span>{t('security.tgP1')}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#27a644] font-bold shrink-0 mt-0.5">&#10003;</span>
            <span>{t('security.tgP2')}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#27a644] font-bold shrink-0 mt-0.5">&#10003;</span>
            <span>{t('security.tgP3')}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#27a644] font-bold shrink-0 mt-0.5">&#10003;</span>
            <span>{t('security.tgP4')}</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Security Badges Strip -->
    <div class="p-5 rounded-xl bg-white dark:bg-[#212427] border border-[#e2e8f0] dark:border-[#282b2e] max-w-4xl mx-auto flex flex-wrap items-center justify-around gap-4 text-center">
      <div>
        <div class="text-xs font-semibold text-[#191b1d] dark:text-[#fafafa] uppercase tracking-wide mb-0.5">GramJS MTProto</div>
        <div class="text-[11px] text-[#707579] dark:text-[#8e9295]">Official Telegram Protocol</div>
      </div>
      <div class="hidden sm:block w-px h-6 bg-[#e2e8f0] dark:bg-[#2e3236]"></div>
      <div>
        <div class="text-xs font-semibold text-[#191b1d] dark:text-[#fafafa] uppercase tracking-wide mb-0.5">Local Storage</div>
        <div class="text-[11px] text-[#707579] dark:text-[#8e9295]">Browser IndexedDB Only</div>
      </div>
      <div class="hidden sm:block w-px h-6 bg-[#e2e8f0] dark:bg-[#2e3236]"></div>
      <div>
        <div class="text-xs font-semibold text-[#191b1d] dark:text-[#fafafa] uppercase tracking-wide mb-0.5">Content Security Policy</div>
        <div class="text-[11px] text-[#707579] dark:text-[#8e9295]">Outbound restricted to telegram.org</div>
      </div>
    </div>

  </div>
</section>
