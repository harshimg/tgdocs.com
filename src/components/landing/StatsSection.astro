---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative py-10 border-y border-[#e5e7eb] dark:border-[#26292c] bg-white/60 dark:bg-[#191b1d]/80 backdrop-blur-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-5 sm:gap-6">
      
      <!-- Metric 1 -->
      <div class="flex flex-col items-center text-center p-5 sm:p-6 rounded-xl bg-[#f8fafc] dark:bg-[#212427] border border-[#e2e8f0] dark:border-[#282b2e] transition-transform duration-150 hover:-translate-y-0.5">
        <div class="text-3xl sm:text-4xl font-extrabold text-[#191b1d] dark:text-[#fafafa] tracking-tight mb-1">
          {t('stats.privateTitle')}
        </div>
        <div class="text-xs sm:text-sm font-semibold text-[#0082c8] mb-1">
          {t('stats.privateSubtitle')}
        </div>
        <p class="text-[11px] sm:text-xs text-[#707579] dark:text-[#8e9295] leading-normal">
          {t('stats.privateDesc')}
        </p>
      </div>

      <!-- Metric 2 -->
      <div class="flex flex-col items-center text-center p-5 sm:p-6 rounded-xl bg-[#f8fafc] dark:bg-[#212427] border border-[#e2e8f0] dark:border-[#282b2e] transition-transform duration-150 hover:-translate-y-0.5">
        <div class="text-3xl sm:text-4xl font-extrabold text-[#191b1d] dark:text-[#fafafa] tracking-tight mb-1">
          {t('stats.fileLimitTitle')}
        </div>
        <div class="text-xs sm:text-sm font-semibold text-[#0082c8] mb-1">
          {t('stats.fileLimitSubtitle')}
        </div>
        <p class="text-[11px] sm:text-xs text-[#707579] dark:text-[#8e9295] leading-normal">
          {t('stats.fileLimitDesc')}
        </p>
      </div>

      <!-- Metric 3 -->
      <div class="flex flex-col items-center text-center p-5 sm:p-6 rounded-xl bg-[#f8fafc] dark:bg-[#212427] border border-[#e2e8f0] dark:border-[#282b2e] transition-transform duration-150 hover:-translate-y-0.5">
        <div class="text-3xl sm:text-4xl font-extrabold text-[#191b1d] dark:text-[#fafafa] tracking-tight mb-1">
          {t('stats.storageTitle')}
        </div>
        <div class="text-xs sm:text-sm font-semibold text-[#0082c8] mb-1">
          {t('stats.storageSubtitle')}
        </div>
        <p class="text-[11px] sm:text-xs text-[#707579] dark:text-[#8e9295] leading-normal">
          {t('stats.storageDesc')}
        </p>
      </div>

      <!-- Metric 4 -->
      <div class="flex flex-col items-center text-center p-5 sm:p-6 rounded-xl bg-[#f8fafc] dark:bg-[#212427] border border-[#e2e8f0] dark:border-[#282b2e] transition-transform duration-150 hover:-translate-y-0.5">
        <div class="text-3xl sm:text-4xl font-extrabold text-[#191b1d] dark:text-[#fafafa] tracking-tight mb-1">
          {t('stats.installTitle')}
        </div>
        <div class="text-xs sm:text-sm font-semibold text-[#0082c8] mb-1">
          {t('stats.installSubtitle')}
        </div>
        <p class="text-[11px] sm:text-xs text-[#707579] dark:text-[#8e9295] leading-normal">
          {t('stats.installDesc')}
        </p>
      </div>

    </div>
  </div>
</section>
