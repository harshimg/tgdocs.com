---
// ScreenshotsSection.astro - Clean App Preview Showcase
---

<section id="screenshots" class="relative py-20 bg-[#f8fafc] dark:bg-[#151719] border-b border-[#e5e7eb] dark:border-[#26292c]">
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#f0f4f8] dark:bg-[#212427] text-[#0082c8] text-xs font-semibold uppercase tracking-wider mb-3 border border-[#e2e8f0] dark:border-[#2e3236]">
        <span>Interface Preview</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#191b1d] dark:text-[#fafafa] tracking-tight mb-3">
        Familiar Google Drive Interface.
      </h2>
      <p class="text-base text-[#5d6c7b] dark:text-[#8e9295] leading-relaxed">
        Everything you expect from modern cloud storage - nested folders, instant search, and thumbnail previews - powered directly by your Telegram account.
      </p>
    </div>

    <!-- Screenshot Showcase Tabs -->
    <div class="flex items-center justify-center gap-2.5 mb-8">
      <button
        id="tab-dashboard-btn"
        type="button"
        class="px-4 py-2 rounded-lg text-xs sm:text-sm font-medium transition-all duration-150 bg-[#0082c8] text-white shadow-sm cursor-pointer"
      >
        <span>📁 File Manager View</span>
      </button>
      <button
        id="tab-security-btn"
        type="button"
        class="px-4 py-2 rounded-lg text-xs sm:text-sm font-medium transition-all duration-150 bg-white dark:bg-[#212427] text-[#707579] dark:text-[#8e9295] hover:text-[#191b1d] dark:hover:text-white border border-[#e2e8f0] dark:border-[#282b2e] cursor-pointer"
      >
        <span>🔒 Secure Uploads</span>
      </button>
    </div>

    <!-- 3D Mockup Frame with Subtle Mouse Tilt -->
    <div id="mockup-tilt-wrapper" class="relative max-w-5xl mx-auto perspective-1200">
      <div
        id="mockup-tilt-card"
        class="relative rounded-2xl bg-white dark:bg-[#191b1d] border border-[#e2e8f0] dark:border-[#282b2e] shadow-xl shadow-black/5 dark:shadow-black/60 overflow-hidden preserve-3d transition-transform duration-150 ease-out"
        style="transform: rotateX(2deg) rotateY(0deg);"
      >
        <!-- Window Top Bar -->
        <div class="px-4 py-3 bg-[#f0f4f8] dark:bg-[#212427] border-b border-[#e2e8f0] dark:border-[#282b2e] flex items-center justify-between select-none">
          <!-- Window Dots -->
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-[#ff5f56]"></span>
            <span class="w-3 h-3 rounded-full bg-[#ffbd2e]"></span>
            <span class="w-3 h-3 rounded-full bg-[#27c93f]"></span>
          </div>

          <!-- URL Bar / Title Mockup -->
          <div class="px-5 py-1 rounded-md bg-white dark:bg-[#191b1d] border border-[#e2e8f0] dark:border-[#2c3035] text-[11px] font-mono text-[#5d6c7b] dark:text-[#8e9295] flex items-center gap-2 max-w-[280px] w-full justify-center truncate">
            <svg class="w-3 h-3 text-[#27a644] shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
            </svg>
            <span class="text-[#191b1d] dark:text-[#fafafa]">https://tgdocs.com/app</span>
          </div>

          <!-- Spacer -->
          <div class="w-12"></div>
        </div>

        <!-- Screenshot Views -->
        <div class="relative aspect-[16/9] w-full bg-[#131518] overflow-hidden">
          
          <!-- View 1: Dashboard Preview -->
          <div id="view-dashboard" class="absolute inset-0 transition-opacity duration-200 opacity-100">
            <img
              src="/images/dashboard-preview.jpg"
              alt="TGDocs Cloud File Manager Dashboard Preview"
              class="w-full h-full object-cover select-none pointer-events-none"
              loading="lazy"
            />
          </div>

          <!-- View 2: Security & Uploads Preview -->
          <div id="view-security" class="absolute inset-0 transition-opacity duration-200 opacity-0 pointer-events-none">
            <img
              src="/images/security-preview.jpg"
              alt="TGDocs MTProto Encrypted Uploads and Transfer Preview"
              class="w-full h-full object-cover select-none pointer-events-none"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Footer Strip on Mockup -->
        <div class="px-6 py-3 bg-[#f8fafc] dark:bg-[#1d2024] border-t border-[#e2e8f0] dark:border-[#282b2e] flex flex-wrap items-center justify-between gap-4 text-xs text-[#707579] dark:text-[#8e9295]">
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#27a644]"></span>
              <span class="text-[#191b1d] dark:text-white font-medium">Telegram Connected</span>
            </div>
            <span class="text-[#cbd5e1] dark:text-[#3a3e44]">•</span>
            <span>Private & Encrypted</span>
          </div>

          <a
            href="/app"
            class="inline-flex items-center text-[#0082c8] hover:underline font-medium transition-colors cursor-pointer"
          >
            <span>Get Started &rarr;</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<script is:inline>
  (function () {
    const tabDashboard = document.getElementById('tab-dashboard-btn');
    const tabSecurity = document.getElementById('tab-security-btn');
    const viewDashboard = document.getElementById('view-dashboard');
    const viewSecurity = document.getElementById('view-security');

    const activeClass = 'px-4 py-2 rounded-lg text-xs sm:text-sm font-medium transition-all duration-150 bg-[#0082c8] text-white shadow-sm cursor-pointer';
    const inactiveClass = 'px-4 py-2 rounded-lg text-xs sm:text-sm font-medium transition-all duration-150 bg-white dark:bg-[#212427] text-[#707579] dark:text-[#8e9295] hover:text-[#191b1d] dark:hover:text-white border border-[#e2e8f0] dark:border-[#282b2e] cursor-pointer';

    if (tabDashboard && tabSecurity && viewDashboard && viewSecurity) {
      tabDashboard.addEventListener('click', function () {
        viewDashboard.classList.remove('opacity-0', 'pointer-events-none');
        viewDashboard.classList.add('opacity-100');
        viewSecurity.classList.remove('opacity-100');
        viewSecurity.classList.add('opacity-0', 'pointer-events-none');

        tabDashboard.className = activeClass;
        tabSecurity.className = inactiveClass;
      });

      tabSecurity.addEventListener('click', function () {
        viewSecurity.classList.remove('opacity-0', 'pointer-events-none');
        viewSecurity.classList.add('opacity-100');
        viewDashboard.classList.remove('opacity-100');
        viewDashboard.classList.add('opacity-0', 'pointer-events-none');

        tabSecurity.className = activeClass;
        tabDashboard.className = inactiveClass;
      });
    }

    const wrapper = document.getElementById('mockup-tilt-wrapper');
    const card = document.getElementById('mockup-tilt-card');

    if (wrapper && card) {
      wrapper.addEventListener('mousemove', function (e) {
        const rect = wrapper.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const normX = (x / rect.width) * 2 - 1;
        const normY = (y / rect.height) * 2 - 1;

        const rotX = -normY * 5;
        const rotY = normX * 6;

        card.style.transform = `rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg)`;
      });

      wrapper.addEventListener('mouseleave', function () {
        card.style.transform = 'rotateX(2deg) rotateY(0deg)';
      });
    }
  })();
</script>
