---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<footer class="border-t border-[#e5e7eb] dark:border-[#26292c] bg-white dark:bg-[#191b1d] pt-14 pb-10 text-[#707579] dark:text-[#8e918f] text-xs transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Multi-Column Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8 lg:gap-12 pb-12 border-b border-[#e5e7eb] dark:border-[#26292c]">
      
      <!-- Brand & Mission Column (spans 2 cols on desktop) -->
      <div class="sm:col-span-2 space-y-4">
        <a href={translatePath('/')} class="flex items-center gap-2.5 group w-fit">
          <img
            src="/logo.svg"
            alt="TGDocs Logo"
            width="34"
            height="34"
            class="w-8.5 h-8.5 rounded-xl object-contain shadow-sm transition-transform duration-200 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
          <div class="flex items-baseline tracking-[0.16em] font-semibold text-lg select-none">
            <span class="text-[#0082c8] font-bold">TG</span>
            <span class="text-[#191b1d] dark:text-[#fafafa] ml-0.5">DOCS</span>
          </div>
        </a>

        <p class="text-xs text-[#5d6c7b] dark:text-[#9aa0a6] leading-relaxed max-w-sm">
          {t('footer.description')}
        </p>
      </div>

      <!-- Column 1: Product -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-[#191b1d] dark:text-[#fafafa]">
          {t('footer.colProduct')}
        </h4>
        <ul class="space-y-2.5">
          <li>
            <a href="/app" class="hover:text-[#0082c8] dark:hover:text-[#fafafa] transition-colors">
              {t('nav.getStarted')}
            </a>
          </li>
          <li>
            <a href={translatePath('/#features')} class="hover:text-[#0082c8] dark:hover:text-[#fafafa] transition-colors">
              {t('footer.features')}
            </a>
          </li>
          <li>
            <a href={translatePath('/#screenshots')} class="hover:text-[#0082c8] dark:hover:text-[#fafafa] transition-colors">
              {t('footer.preview')}
            </a>
          </li>
          <li>
            <a href={translatePath('/#how-it-works')} class="hover:text-[#0082c8] dark:hover:text-[#fafafa] transition-colors">
              {t('footer.howItWorks')}
            </a>
          </li>
          <li>
            <a href={translatePath('/#security')} class="hover:text-[#0082c8] dark:hover:text-[#fafafa] transition-colors">
              {t('footer.security')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 2: Resources & About -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-[#191b1d] dark:text-[#fafafa]">
          {t('footer.colCompany')}
        </h4>
        <ul class="space-y-2.5">
          <li>
            <a href={translatePath('/about')} class="hover:text-[#0082c8] dark:hover:text-[#fafafa] transition-colors">
              {t('footer.about')}
            </a>
          </li>
          <li>
            <a href={translatePath('/contact')} class="hover:text-[#0082c8] dark:hover:text-[#fafafa] transition-colors">
              {t('footer.contact')}
            </a>
          </li>
          <li>
            <a
              href="https://github.com/harshimg/tgdocs.com"
              target="_blank"
              rel="noreferrer"
              class="hover:text-[#0082c8] dark:hover:text-[#fafafa] transition-colors inline-flex items-center gap-1"
            >
              <span>GitHub</span>
              <svg class="w-3 h-3 text-[#9aa0a6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/harshimg/tgdocs.com/issues"
              target="_blank"
              rel="noreferrer"
              class="hover:text-[#0082c8] dark:hover:text-[#fafafa] transition-colors inline-flex items-center gap-1"
            >
              <span>{t('footer.reportBug')}</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Legal & Trust -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-[#191b1d] dark:text-[#fafafa]">
          {t('footer.colLegal')}
        </h4>
        <ul class="space-y-2.5">
          <li>
            <a href={translatePath('/terms')} class="hover:text-[#0082c8] dark:hover:text-[#fafafa] transition-colors">
              {t('footer.terms')}
            </a>
          </li>
          <li>
            <a href={translatePath('/privacy')} class="hover:text-[#0082c8] dark:hover:text-[#fafafa] transition-colors">
              {t('footer.privacy')}
            </a>
          </li>
          <li>
            <a href={translatePath('/contact#faq')} class="hover:text-[#0082c8] dark:hover:text-[#fafafa] transition-colors">
              {t('footer.securityFaq')}
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Disclaimer & Copyright Bar -->
    <div class="pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-[11px] text-[#707579] dark:text-[#8e9295]">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-center md:text-left">
        <span>© {new Date().getFullYear()} {t('footer.copyright')}</span>
        <span>•</span>
        <a href={translatePath('/terms')} class="hover:underline">{t('footer.terms')}</a>
        <span>•</span>
        <a href={translatePath('/privacy')} class="hover:underline">{t('footer.privacy')}</a>
        <span>•</span>
        <a href={translatePath('/about')} class="hover:underline">{t('footer.about')}</a>
      </div>

      <div class="text-center md:text-right max-w-xl text-[10.5px] text-[#8e9295] dark:text-[#6b7280] leading-relaxed">
        {t('footer.disclaimer')}
      </div>
    </div>

  </div>
</footer>
