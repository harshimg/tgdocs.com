---
// FeaturesSection.astro - Clean 3D Tilt Feature Grid (tgstorage styling)
---

<section id="features" class="relative py-20 bg-white dark:bg-[#191b1d] border-b border-[#e5e7eb] dark:border-[#26292c]">
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#f0f4f8] dark:bg-[#212427] text-[#0082c8] text-xs font-semibold uppercase tracking-wider mb-3 border border-[#e2e8f0] dark:border-[#2e3236]">
        <span>Features</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#191b1d] dark:text-[#fafafa] tracking-tight mb-3">
        Cloud Storage. No Middlemen.
      </h2>
      <p class="text-base text-[#5d6c7b] dark:text-[#8e9295] leading-relaxed">
        TGDocs turns Telegram’s fast global cloud infrastructure into a private, full-featured web drive that only you control.
      </p>
    </div>

    <!-- 3D Tilt Feature Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 perspective-1000">
      
      <!-- Feature Card 1 -->
      <div class="tilt-card relative p-6 rounded-2xl bg-[#f8fafc] dark:bg-[#212427] border border-[#e2e8f0] dark:border-[#282b2e] hover:border-[#0082c8] dark:hover:border-[#3a3e43] transition-all duration-200 preserve-3d group shadow-sm hover:shadow-md">
        <div class="w-10 h-10 rounded-xl bg-[#f0f4f8] dark:bg-[#282b2e] text-[#0082c8] flex items-center justify-center mb-4 transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-[#191b1d] dark:text-[#fafafa] mb-2">
          Direct MTProto Protocol
        </h3>
        <p class="text-xs sm:text-sm text-[#5d6c7b] dark:text-[#8e9295] leading-relaxed">
          Your browser opens direct binary WebSocket connections to Telegram data centers. Your data never passes through any intermediate proxy.
        </p>
      </div>

      <!-- Feature Card 2 -->
      <div class="tilt-card relative p-6 rounded-2xl bg-[#f8fafc] dark:bg-[#212427] border border-[#e2e8f0] dark:border-[#282b2e] hover:border-[#0082c8] dark:hover:border-[#3a3e43] transition-all duration-200 preserve-3d group shadow-sm hover:shadow-md">
        <div class="w-10 h-10 rounded-xl bg-[#f0f4f8] dark:bg-[#282b2e] text-[#0082c8] flex items-center justify-center mb-4 transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-[#191b1d] dark:text-[#fafafa] mb-2">
          Google Drive Experience
        </h3>
        <p class="text-xs sm:text-sm text-[#5d6c7b] dark:text-[#8e9295] leading-relaxed">
          Organize Telegram messages into real nested folders, switch between grid and list views, drag & drop files, and sort by date or size.
        </p>
      </div>

      <!-- Feature Card 3 -->
      <div class="tilt-card relative p-6 rounded-2xl bg-[#f8fafc] dark:bg-[#212427] border border-[#e2e8f0] dark:border-[#282b2e] hover:border-[#0082c8] dark:hover:border-[#3a3e43] transition-all duration-200 preserve-3d group shadow-sm hover:shadow-md">
        <div class="w-10 h-10 rounded-xl bg-[#f0f4f8] dark:bg-[#282b2e] text-[#0082c8] flex items-center justify-center mb-4 transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-[#191b1d] dark:text-[#fafafa] mb-2">
          Full 2FA & Session Security
        </h3>
        <p class="text-xs sm:text-sm text-[#5d6c7b] dark:text-[#8e9295] leading-relaxed">
          Full support for Telegram Two-Step Verification (Cloud Password). Sessions are encrypted in your browser's IndexedDB and can be terminated anytime.
        </p>
      </div>

      <!-- Feature Card 4 -->
      <div class="tilt-card relative p-6 rounded-2xl bg-[#f8fafc] dark:bg-[#212427] border border-[#e2e8f0] dark:border-[#282b2e] hover:border-[#0082c8] dark:hover:border-[#3a3e43] transition-all duration-200 preserve-3d group shadow-sm hover:shadow-md">
        <div class="w-10 h-10 rounded-xl bg-[#f0f4f8] dark:bg-[#282b2e] text-[#0082c8] flex items-center justify-center mb-4 transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-[#191b1d] dark:text-[#fafafa] mb-2">
          Truly Unlimited Storage
        </h3>
        <p class="text-xs sm:text-sm text-[#5d6c7b] dark:text-[#8e9295] leading-relaxed">
          Telegram imposes no quota on the total volume of files in your Saved Messages. Store documents, videos, backups, and photos without limits.
        </p>
      </div>

      <!-- Feature Card 5 -->
      <div class="tilt-card relative p-6 rounded-2xl bg-[#f8fafc] dark:bg-[#212427] border border-[#e2e8f0] dark:border-[#282b2e] hover:border-[#0082c8] dark:hover:border-[#3a3e43] transition-all duration-200 preserve-3d group shadow-sm hover:shadow-md">
        <div class="w-10 h-10 rounded-xl bg-[#f0f4f8] dark:bg-[#282b2e] text-[#0082c8] flex items-center justify-center mb-4 transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-[#191b1d] dark:text-[#fafafa] mb-2">
          Up to 4GB Single Files
        </h3>
        <p class="text-xs sm:text-sm text-[#5d6c7b] dark:text-[#8e9295] leading-relaxed">
          Upload files up to 2GB on standard accounts, or 4GB on Telegram Premium. Multi-part chunking ensures fast, reliable transfers.
        </p>
      </div>

      <!-- Feature Card 6 -->
      <div class="tilt-card relative p-6 rounded-2xl bg-[#f8fafc] dark:bg-[#212427] border border-[#e2e8f0] dark:border-[#282b2e] hover:border-[#0082c8] dark:hover:border-[#3a3e43] transition-all duration-200 preserve-3d group shadow-sm hover:shadow-md">
        <div class="w-10 h-10 rounded-xl bg-[#f0f4f8] dark:bg-[#282b2e] text-[#0082c8] flex items-center justify-center mb-4 transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="16 18 22 12 16 6" />
            <polyline points="8 6 2 12 8 18" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-[#191b1d] dark:text-[#fafafa] mb-2">
          Zero Vendor Lock-In
        </h3>
        <p class="text-xs sm:text-sm text-[#5d6c7b] dark:text-[#8e9295] leading-relaxed">
          Every file is directly visible inside your official Telegram app under Saved Messages. You always retain 100% access.
        </p>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  (function () {
    const cards = document.querySelectorAll('.tilt-card');
    cards.forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const normX = (x / rect.width) * 2 - 1;
        const normY = (y / rect.height) * 2 - 1;

        const rotX = -normY * 6;
        const rotY = normX * 6;

        card.style.transform = `perspective(800px) rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg) translateZ(6px)`;
      });

      card.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) translateZ(0px)';
      });
    });
  })();
</script>
