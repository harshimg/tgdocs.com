---
// HowItWorksSection.astro - Clean 3-Step Setup Guide
---

<section id="how-it-works" class="relative py-20 bg-white dark:bg-[#191b1d] border-b border-[#e5e7eb] dark:border-[#26292c]">
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#f0f4f8] dark:bg-[#212427] text-[#0082c8] text-xs font-semibold uppercase tracking-wider mb-3 border border-[#e2e8f0] dark:border-[#2e3236]">
        <span>Quick Setup</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#191b1d] dark:text-[#fafafa] tracking-tight mb-3">
        How TGDocs Works
      </h2>
      <p class="text-base text-[#5d6c7b] dark:text-[#8e9295] leading-relaxed">
        Start managing your Telegram cloud files in under 30 seconds. No registration forms, no payment methods, and zero third-party accounts.
      </p>
    </div>

    <!-- Step Grid with Visual Connectors -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 relative">
      
      <!-- Subtle Connecting Line (Desktop) -->
      <div class="hidden md:block absolute top-14 left-1/6 right-1/6 h-[1px] bg-[#e2e8f0] dark:bg-[#2e3236] z-0"></div>

      <!-- Step 1 -->
      <div class="relative z-10 flex flex-col items-center text-center p-6 sm:p-7 rounded-2xl bg-[#f8fafc] dark:bg-[#212427] border border-[#e2e8f0] dark:border-[#282b2e] transition-transform duration-150 hover:-translate-y-1 shadow-sm">
        <!-- Numbered Step Badge -->
        <div class="w-12 h-12 rounded-xl bg-[#0082c8] text-white font-bold text-lg flex items-center justify-center mb-5 shadow-sm">
          1
        </div>
        <h3 class="text-base sm:text-lg font-bold text-[#191b1d] dark:text-[#fafafa] mb-2">
          Connect via Telegram
        </h3>
        <p class="text-xs sm:text-sm text-[#5d6c7b] dark:text-[#8e9295] leading-relaxed mb-5">
          Enter your phone number and verify via the official Telegram login code sent directly to your existing Telegram session.
        </p>
        <div class="mt-auto px-3 py-1 rounded-md bg-white dark:bg-[#191b1d] text-[11px] font-mono text-[#5d6c7b] dark:text-[#8e9295] border border-[#e2e8f0] dark:border-[#282b2e]">
          MTProto Browser Auth
        </div>
      </div>

      <!-- Step 2 -->
      <div class="relative z-10 flex flex-col items-center text-center p-6 sm:p-7 rounded-2xl bg-[#f8fafc] dark:bg-[#212427] border border-[#e2e8f0] dark:border-[#282b2e] transition-transform duration-150 hover:-translate-y-1 shadow-sm">
        <!-- Numbered Step Badge -->
        <div class="w-12 h-12 rounded-xl bg-[#0082c8] text-white font-bold text-lg flex items-center justify-center mb-5 shadow-sm">
          2
        </div>
        <h3 class="text-base sm:text-lg font-bold text-[#191b1d] dark:text-[#fafafa] mb-2">
          Virtual Folder Indexing
        </h3>
        <p class="text-xs sm:text-sm text-[#5d6c7b] dark:text-[#8e9295] leading-relaxed mb-5">
          TGDocs indexes your personal Saved Messages chat and builds a high-speed virtual folder hierarchy in your browser.
        </p>
        <div class="mt-auto px-3 py-1 rounded-md bg-white dark:bg-[#191b1d] text-[11px] font-mono text-[#5d6c7b] dark:text-[#8e9295] border border-[#e2e8f0] dark:border-[#282b2e]">
          IndexedDB Local Cache
        </div>
      </div>

      <!-- Step 3 -->
      <div class="relative z-10 flex flex-col items-center text-center p-6 sm:p-7 rounded-2xl bg-[#f8fafc] dark:bg-[#212427] border border-[#e2e8f0] dark:border-[#282b2e] transition-transform duration-150 hover:-translate-y-1 shadow-sm">
        <!-- Numbered Step Badge -->
        <div class="w-12 h-12 rounded-xl bg-[#0082c8] text-white font-bold text-lg flex items-center justify-center mb-5 shadow-sm">
          3
        </div>
        <h3 class="text-base sm:text-lg font-bold text-[#191b1d] dark:text-[#fafafa] mb-2">
          Upload & Access Anywhere
        </h3>
        <p class="text-xs sm:text-sm text-[#5d6c7b] dark:text-[#8e9295] leading-relaxed mb-5">
          Enjoy clean file management. Upload up to 4GB files, create folders, search filenames, and download at full line speed.
        </p>
        <div class="mt-auto px-3 py-1 rounded-md bg-white dark:bg-[#191b1d] text-[11px] font-mono text-[#5d6c7b] dark:text-[#8e9295] border border-[#e2e8f0] dark:border-[#282b2e]">
          Google Drive Experience
        </div>
      </div>

    </div>

  </div>
</section>
