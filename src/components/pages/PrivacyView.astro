---
import Layout from '../../layouts/Layout.astro';
import LandingNavbar from '../landing/LandingNavbar.astro';
import LandingFooter from '../landing/LandingFooter.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout
  title={t('privacy.metaTitle')}
  description={t('privacy.metaDesc')}
  lang={lang}
  isApp={false}
>
  <div class="relative min-h-screen bg-[#f5f5f6] dark:bg-[#191b1d] text-[#212427] dark:text-[#fafafa] flex flex-col transition-colors duration-200">
    <LandingNavbar />

    <main class="flex-1 py-12 sm:py-16">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header -->
        <div class="mb-10 text-center sm:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#f0f4f8] dark:bg-[#212427] text-[#0082c8] text-xs font-semibold uppercase tracking-wider mb-3 border border-[#e2e8f0] dark:border-[#2e3236]">
            <span>{t('privacy.tag')}</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-[#191b1d] dark:text-[#fafafa] tracking-tight mb-2">
            {t('privacy.title')}
          </h1>
          <p class="text-xs text-[#707579] dark:text-[#8e9295]">
            {t('privacy.lastUpdated')}
          </p>
        </div>

        <!-- Content Card -->
        <div class="bg-white dark:bg-[#212427] rounded-3xl p-6 sm:p-10 border border-[#e5e7eb] dark:border-[#2e3236] shadow-xs space-y-8 text-sm sm:text-[14.5px] text-[#4b5563] dark:text-[#c4c7c5] leading-relaxed">
          
          <!-- Summary Callout -->
          <div class="p-4 sm:p-5 rounded-2xl bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900/50 space-y-2 text-xs sm:text-sm text-emerald-900 dark:text-emerald-200">
            <h3 class="font-bold flex items-center gap-2 text-emerald-800 dark:text-emerald-300">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              {t('privacy.promiseTitle')}
            </h3>
            <p>
              {t('privacy.promiseDesc')}
            </p>
          </div>

          <!-- 1. Zero Server-Side Data Collection -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('privacy.s1Title')}
            </h2>
            <p>
              {t('privacy.s1P1')}
            </p>
            <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm">
              <li>{t('privacy.s1B1')}</li>
              <li>{t('privacy.s1B2')}</li>
              <li>{t('privacy.s1B3')}</li>
              <li>{t('privacy.s1B4')}</li>
            </ul>
          </section>

          <!-- 2. Local Browser Storage -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('privacy.s2Title')}
            </h2>
            <p>
              {t('privacy.s2P1')}
            </p>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs border border-[#e5e7eb] dark:border-[#2e3236] rounded-xl overflow-hidden">
                <thead class="bg-[#f9fafb] dark:bg-[#191b1d] text-[#191b1d] dark:text-[#fafafa]">
                  <tr>
                    <th class="p-2.5 font-semibold">{t('privacy.thKey')}</th>
                    <th class="p-2.5 font-semibold">{t('privacy.thPurpose')}</th>
                    <th class="p-2.5 font-semibold">{t('privacy.thStorage')}</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[#e5e7eb] dark:divide-[#2e3236]">
                  <tr>
                    <td class="p-2.5 font-mono text-[11px]">tgdocs_session</td>
                    <td class="p-2.5">{t('privacy.t1Desc')}</td>
                    <td class="p-2.5">{t('privacy.t1Storage')}</td>
                  </tr>
                  <tr>
                    <td class="p-2.5 font-mono text-[11px]">tgdocs_theme</td>
                    <td class="p-2.5">{t('privacy.t2Desc')}</td>
                    <td class="p-2.5">{t('privacy.t2Storage')}</td>
                  </tr>
                  <tr>
                    <td class="p-2.5 font-mono text-[11px]">tgdocs_metadata_cache</td>
                    <td class="p-2.5">{t('privacy.t3Desc')}</td>
                    <td class="p-2.5">{t('privacy.t3Storage')}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <!-- 3. Direct Telegram Connection -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('privacy.s3Title')}
            </h2>
            <p>
              {t('privacy.s3P1')}
            </p>
            <p>
              {t('privacy.s3P2')} <a href="https://telegram.org/privacy" target="_blank" rel="noreferrer" class="text-[#0082c8] underline">{t('privacy.s3Link')}</a>.
            </p>
          </section>

          <!-- 4. Data Deletion (Logging Out) -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('privacy.s4Title')}
            </h2>
            <p>
              {t('privacy.s4P1')}
            </p>
            <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm">
              <li>{t('privacy.s4B1')}</li>
              <li>{t('privacy.s4B2')}</li>
              <li>{t('privacy.s4B3')}</li>
            </ul>
          </section>

          <!-- 5. Cookies and Trackers -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('privacy.s5Title')}
            </h2>
            <p>
              {t('privacy.s5P1')}
            </p>
          </section>

          <!-- 6. Children's Privacy -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('privacy.s6Title')}
            </h2>
            <p>
              {t('privacy.s6P1')}
            </p>
          </section>

          <!-- 7. Open Source Verification -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('privacy.s7Title')}
            </h2>
            <p>
              {t('privacy.s7P1')} <a href="https://github.com/harshimg/tgdocs.com" target="_blank" rel="noreferrer" class="text-[#0082c8] underline font-medium">github.com/harshimg/tgdocs.com</a>. {t('privacy.s7P2')}
            </p>
          </section>

          <!-- 8. Updates to this Policy -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('privacy.s8Title')}
            </h2>
            <p>
              {t('privacy.s8P1')}
            </p>
          </section>

          <!-- 9. Contact -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('privacy.s9Title')}
            </h2>
            <p>
              {t('privacy.s9P1')} <a href="https://github.com/harshimg/tgdocs.com" target="_blank" rel="noreferrer" class="text-[#0082c8] underline">GitHub repository</a> {t('terms.s10Or')} <a href={translatePath('/contact')} class="text-[#0082c8] underline">{t('terms.s10ContactLink')}</a>.
            </p>
          </section>

        </div>

      </div>
    </main>

    <LandingFooter />
  </div>
</Layout>
