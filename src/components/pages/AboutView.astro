---
import Layout from '../../layouts/Layout.astro';
import LandingNavbar from '../landing/LandingNavbar.astro';
import LandingFooter from '../landing/LandingFooter.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout
  title="About TGDocs — Client-Side Telegram Cloud File Manager"
  description="Learn about the mission, architecture, and open-source principles behind TGDocs, a zero-server Google Drive-style client for Telegram Cloud."
  lang={lang}
  isApp={false}
>
  <div class="relative min-h-screen bg-[#f5f5f6] dark:bg-[#191b1d] text-[#212427] dark:text-[#fafafa] flex flex-col transition-colors duration-200">
    <LandingNavbar />

    <main class="flex-1 py-12 sm:py-16 lg:py-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Hero Section -->
        <div class="text-center max-w-2xl mx-auto mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#f0f4f8] dark:bg-[#212427] text-[#0082c8] text-xs font-semibold uppercase tracking-wider mb-4 border border-[#e2e8f0] dark:border-[#2e3236]">
            <span>Our Mission</span>
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#191b1d] dark:text-[#fafafa] tracking-tight leading-tight mb-5">
            Cloud Storage Reimagined: <br />
            <span class="text-[#0082c8]">Private, Serverless, Free.</span>
          </h1>
          <p class="text-base sm:text-lg text-[#5d6c7b] dark:text-[#8e9295] leading-relaxed">
            TGDocs bridges the gap between Telegram's unlimited cloud infrastructure and Google Drive's familiar folder-based file organization — executed completely inside your browser.
          </p>
        </div>

        <!-- The Origin Story & Problem -->
        <div class="bg-white dark:bg-[#212427] rounded-3xl p-6 sm:p-10 border border-[#e5e7eb] dark:border-[#2e3236] shadow-xs mb-12">
          <h2 class="text-2xl font-bold text-[#191b1d] dark:text-[#fafafa] mb-4">
            Why TGDocs was Created
          </h2>
          <div class="space-y-4 text-[#4b5563] dark:text-[#c4c7c5] text-sm sm:text-base leading-relaxed">
            <p>
              Telegram offers one of the most resilient, globally distributed cloud infrastructures in the world. Users have long used Telegram's <strong>"Saved Messages"</strong> and private channels as an ad-hoc personal cloud drive to store photos, documents, archives, and videos up to 2 GB (or 4 GB for Premium users) with unlimited storage.
            </p>
            <p>
              However, chat lists were never designed to be file managers. As you accumulate thousands of files over years, searching through linear chat histories becomes disorganized: no nested folders, no drag-and-drop hierarchy, and no Google Drive-style workspace view.
            </p>
            <p>
              Traditional third-party cloud storage providers solve this by asking you to upload files to <em>their</em> proprietary servers, paying hefty monthly subscription fees, and surrendering your data privacy.
            </p>
            <p class="font-medium text-[#191b1d] dark:text-[#fafafa]">
              TGDocs solves this elegantly: a modern, clean web file manager that speaks directly to Telegram via official MTProto protocols without a single intermediary server in between.
            </p>
          </div>
        </div>

        <!-- Core Architectural Pillars Grid -->
        <div class="mb-14">
          <h2 class="text-xl sm:text-2xl font-bold text-center text-[#191b1d] dark:text-[#fafafa] mb-8">
            The Three Foundational Pillars
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <!-- Pillar 1 -->
            <div class="bg-white dark:bg-[#212427] rounded-2xl p-6 border border-[#e5e7eb] dark:border-[#2e3236] flex flex-col">
              <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-[#0082c8] flex items-center justify-center mb-4">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <h3 class="text-base font-bold text-[#191b1d] dark:text-[#fafafa] mb-2">
                100% Client-Side
              </h3>
              <p class="text-xs sm:text-sm text-[#5d6c7b] dark:text-[#8e9295] leading-relaxed">
                TGDocs has no backend servers, no user database, and no logs. The web app is static JavaScript running solely in your local browser sandbox.
              </p>
            </div>

            <!-- Pillar 2 -->
            <div class="bg-white dark:bg-[#212427] rounded-2xl p-6 border border-[#e5e7eb] dark:border-[#2e3236] flex flex-col">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <h3 class="text-base font-bold text-[#191b1d] dark:text-[#fafafa] mb-2">
                Direct MTProto WSS
              </h3>
              <p class="text-xs sm:text-sm text-[#5d6c7b] dark:text-[#8e9295] leading-relaxed">
                Your browser connects directly to Telegram's official Data Centers over secure WebSockets (<code class="text-[11px] bg-[#f0f4f8] dark:bg-[#191b1d] px-1 py-0.5 rounded">wss://*.web.telegram.org</code>).
              </p>
            </div>

            <!-- Pillar 3 -->
            <div class="bg-white dark:bg-[#212427] rounded-2xl p-6 border border-[#e5e7eb] dark:border-[#2e3236] flex flex-col">
              <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center mb-4">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              </div>
              <h3 class="text-base font-bold text-[#191b1d] dark:text-[#fafafa] mb-2">
                Open & Auditable
              </h3>
              <p class="text-xs sm:text-sm text-[#5d6c7b] dark:text-[#8e9295] leading-relaxed">
                Every line of source code is openly hosted on GitHub. Anyone can inspect network traffic, verify cryptographic logic, or self-host their own instance.
              </p>
            </div>

          </div>
        </div>

        <!-- How It Works Flow -->
        <div class="bg-white dark:bg-[#212427] rounded-3xl p-6 sm:p-10 border border-[#e5e7eb] dark:border-[#2e3236] shadow-xs mb-12">
          <h2 class="text-2xl font-bold text-[#191b1d] dark:text-[#fafafa] mb-6">
            Under the Hood
          </h2>

          <div class="space-y-6 text-sm text-[#4b5563] dark:text-[#c4c7c5]">
            <div class="flex items-start gap-4">
              <div class="w-7 h-7 rounded-full bg-[#0082c8] text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
                1
              </div>
              <div>
                <h4 class="font-bold text-[#191b1d] dark:text-[#fafafa] text-base mb-1">
                  Local Key Generation & Storage
                </h4>
                <p class="leading-relaxed text-[#5d6c7b] dark:text-[#8e9295]">
                  When you authenticate via phone code or QR, MTProto session authorization keys are computed in memory and securely preserved in your browser's encrypted local storage. They are never sent to any third-party server.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-7 h-7 rounded-full bg-[#0082c8] text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
                2
              </div>
              <div>
                <h4 class="font-bold text-[#191b1d] dark:text-[#fafafa] text-base mb-1">
                  Dedicated Private Storage Channel
                </h4>
                <p class="leading-relaxed text-[#5d6c7b] dark:text-[#8e9295]">
                  TGDocs creates a dedicated private Telegram channel named <strong>"TGDocs Cloud Storage"</strong> in your account. Only you can read or write to this channel.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-7 h-7 rounded-full bg-[#0082c8] text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
                3
              </div>
              <div>
                <h4 class="font-bold text-[#191b1d] dark:text-[#fafafa] text-base mb-1">
                  Multi-Device Metadata Synchronization
                </h4>
                <p class="leading-relaxed text-[#5d6c7b] dark:text-[#8e9295]">
                  Folder structures, nested paths, and file tags are stored as lightweight state snapshots synced to a private metadata channel. Wherever you log in, your full folder tree reconstitutes instantly.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Call to Action Card -->
        <div class="bg-gradient-to-br from-[#0082c8] to-[#005a8c] rounded-3xl p-8 sm:p-12 text-center text-white shadow-lg">
          <h2 class="text-2xl sm:text-3xl font-bold mb-4">
            Ready to Organize Your Telegram Cloud?
          </h2>
          <p class="text-sm sm:text-base text-blue-100 max-w-lg mx-auto mb-8">
            No installation, no downloads, and no credit card required. Experience your personal cloud storage today.
          </p>
          <a
            href="/app"
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-white text-[#0082c8] hover:bg-blue-50 font-semibold text-sm sm:text-base shadow-md transition-all duration-150 cursor-pointer"
          >
            <span>Get Started</span>
          </a>
        </div>

      </div>
    </main>

    <LandingFooter />
  </div>
</Layout>
