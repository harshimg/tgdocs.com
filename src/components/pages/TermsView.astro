---
import Layout from '../../layouts/Layout.astro';
import LandingNavbar from '../landing/LandingNavbar.astro';
import LandingFooter from '../landing/LandingFooter.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout
  title={t('terms.metaTitle')}
  description={t('terms.metaDesc')}
  lang={lang}
  isApp={false}
>
  <div class="relative min-h-screen bg-[#f5f5f6] dark:bg-[#191b1d] text-[#212427] dark:text-[#fafafa] flex flex-col transition-colors duration-200">
    <LandingNavbar />

    <main class="flex-1 py-12 sm:py-16">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header -->
        <div class="mb-10 text-center sm:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#f0f4f8] dark:bg-[#212427] text-[#0082c8] text-xs font-semibold uppercase tracking-wider mb-3 border border-[#e2e8f0] dark:border-[#2e3236]">
            <span>{t('terms.tag')}</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-[#191b1d] dark:text-[#fafafa] tracking-tight mb-2">
            {t('terms.title')}
          </h1>
          <p class="text-xs text-[#707579] dark:text-[#8e9295]">
            {t('terms.lastUpdated')}
          </p>
        </div>

        <!-- Content Card -->
        <div class="bg-white dark:bg-[#212427] rounded-3xl p-6 sm:p-10 border border-[#e5e7eb] dark:border-[#2e3236] shadow-xs space-y-8 text-sm sm:text-[14.5px] text-[#4b5563] dark:text-[#c4c7c5] leading-relaxed">
          
          <!-- 1. Introduction -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('terms.s1Title')}
            </h2>
            <p>
              {t('terms.s1P1')}
            </p>
          </section>

          <!-- 2. Nature of Service -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('terms.s2Title')}
            </h2>
            <p>
              {t('terms.s2P1')}
            </p>
            <p>
              <strong>{t('terms.s2Strong')}</strong> {t('terms.s2P2')}
            </p>
          </section>

          <!-- 3. Telegram Non-Affiliation -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('terms.s3Title')}
            </h2>
            <div class="p-4 rounded-xl bg-blue-50/70 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-900/50 text-xs text-[#005a8c] dark:text-[#93c5fd]">
              <strong>{t('terms.s3NoticePrefix')}</strong> {t('terms.s3NoticeText')}
            </div>
            <p>
              {t('terms.s3P1')} <a href="https://telegram.org/tos" target="_blank" rel="noreferrer" class="text-[#0082c8] underline">{t('terms.s3TosLink')}</a>.
            </p>
          </section>

          <!-- 4. User Responsibilities & Account Security -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('terms.s4Title')}
            </h2>
            <p>
              {t('terms.s4P1')}
            </p>
            <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm">
              <li>{t('terms.s4B1')}</li>
              <li>{t('terms.s4B2')}</li>
              <li>{t('terms.s4B3')}</li>
              <li>{t('terms.s4B4')}</li>
            </ul>
          </section>

          <!-- 5. Acceptable Use Policy -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('terms.s5Title')}
            </h2>
            <p>
              {t('terms.s5P1')}
            </p>
            <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm">
              <li>{t('terms.s5B1')}</li>
              <li>{t('terms.s5B2')}</li>
              <li>{t('terms.s5B3')}</li>
              <li>{t('terms.s5B4')}</li>
            </ul>
          </section>

          <!-- 6. Intellectual Property & Open Source License -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('terms.s6Title')}
            </h2>
            <p>
              {t('terms.s6P1')}
            </p>
          </section>

          <!-- 7. Disclaimer of Warranties -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('terms.s7Title')}
            </h2>
            <p class="text-xs uppercase tracking-wider text-[#707579] dark:text-[#8e9295] font-semibold">
              {t('terms.s7Notice')}
            </p>
            <p>
              {t('terms.s7P1')}
            </p>
            <p>
              {t('terms.s7P2')}
            </p>
          </section>

          <!-- 8. Limitation of Liability -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('terms.s8Title')}
            </h2>
            <p>
              {t('terms.s8P1')}
            </p>
          </section>

          <!-- 9. Changes to Terms -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('terms.s9Title')}
            </h2>
            <p>
              {t('terms.s9P1')}
            </p>
          </section>

          <!-- 10. Contact -->
          <section class="space-y-3">
            <h2 class="text-lg sm:text-xl font-bold text-[#191b1d] dark:text-[#fafafa]">
              {t('terms.s10Title')}
            </h2>
            <p>
              {t('terms.s10P1')} <a href="https://github.com/harshimg/tgdocs.com" target="_blank" rel="noreferrer" class="text-[#0082c8] underline">GitHub repository</a> {t('terms.s10Or')} <a href={translatePath('/contact')} class="text-[#0082c8] underline">{t('terms.s10ContactLink')}</a>.
            </p>
          </section>

        </div>

      </div>
    </main>

    <LandingFooter />
  </div>
</Layout>
